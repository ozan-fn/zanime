rel=\"alternate\" hreflang=\"id\" href=\"https://subdl.com/id/subtitle/sd1667204/frieren-beyond-journeys-end\"><link rel=\"alternate\" hreflang=\"ko\" href=\"https://subdl.com/ko/subtitle/sd1667204/frieren-beyond-journeys-end\"><link rel=\"alternate\" hreflang=\"x-default\" href=\"https://subdl.com/subtitle/sd1667204/frieren-beyond-journeys-end\"><link rel=\"alternate\" type=\"text/plain\" href=\"https://subdl.com/llms.txt\" title=\"llms.txt\"><link rel=\"alternate\" type=\"text/plain\" href=\"https://subdl.com/llms-full.txt\" title=\"llms-full.txt\"><!-- Main font Roboto is self-hosted (see @fontsource imports in the\n         frontmatter); RTL locales use self-hosted iranyekan (@font-face in\n         global.css). No Google Fonts fetch — works even where that CDN is\n         blocked (Iran). --><link rel=\"manifest\" href=\"/manifest.json\"><meta name=\"theme-color\" content=\"#FFEE2A\"><link rel=\"apple-touch-icon\" href=\"/logo/fav.png\"><link rel=\"icon\" href=\"/favicon.ico\"><!-- Theme bootstrap (next-themes equivalent: attribute=class, system\n         default). Runs before paint so there's no light/dark flash. --><script>\n      (function () {\n        try {\n          var t = localStorage.getItem(\"theme\")\n          var dark =\n            t === \"dark\" ||\n            ((!t || t === \"system\") &&\n              window.matchMedia(\"(prefers-color-scheme: dark)\").matches)\n          document.documentElement.classList.toggle(\"dark\", dark)\n        } catch (e) {}\n      })()\n    </script><!-- First-touch signup attribution. Records where a visitor arrived from,\n         once, so the account they may create later can be attributed.\n\n         WHY THIS IS CLIENT-SIDE. Two independent reasons: public HTML is\n         edge-cached, so middleware does not run on a cache HIT and a server-set\n         cookie would miss most landings; and rule 4 forbids server cookies on\n         anonymous HTML outright. The Referer on the register POST is useless\n         either way -- it is the bare origin, because middleware pins\n         Referrer-Policy: strict-origin-when-cross-origin.\n\n         Host only, never the full referrer URL: browsers already send\n         origin-only cross-origin referrers, so a full URL would be empty most\n         of the time and carry other sites' query strings the rest of it.\n\n         STRICT first-write-wins -- an existing record is never touched, not\n         even to \"upgrade\" a direct one, because that is last-touch wearing a\n         first-touch costume. No classification happens here: the taxonomy is\n         server-side so it can change without a full-zone cache purge. This\n         block is a permanent byte tax on every cached HTML document and can\n         only be changed by a purge, so it stays small and versioned. --><script>\n      ;(function () {\n        var KEY = \"sdl_attr\"\n        // Us, plus the OAuth/payment hosts a visitor bounces through mid-flow.\n        // accounts.google.com is the critical one: on the OAuth return leg it\n        // becomes document.referrer for ~60% of signups, and anything matching\n        // \"google\" loosely would file them all as organic search.\n        //\n        // strem.top is deliberately NOT here. subdl.strem.top carries our name\n        // but is a THIRD-PARTY addon, and it is currently the largest single\n        // source of new accounts — treating it as internal would discard the\n        // referrer for the channel this whole feature exists to measure.\n        var SKIP =\n          /(^|\\.)(subdl\\.com|subdl\\.net)$|^(accounts\\.google\\.com|challenges\\.cloudflare\\.com|appleid\\.apple\\.com)$|(^|\\.)(paypal\\.com|oxapay\\.com|nowpayments\\.io)$/\n        function read(s) {\n          try {\n            return s && s.getItem(KEY)\n          } catch (e) {\n            return null\n          }\n        }\n        try {\n          // Any existing record wins, wherever it lives.\n          if (read(window.localStorage) || read(window.sessionStorage)) return\n          if (window.__sdlAttr) return\n\n          var host = \"\"\n          if (document.referrer) {\n            try {\n              var h = new URL(document.referrer).hostname.toLowerCase().replace(/^www\\./, \"\")\n              if (!SKIP.test(h)) host = h\n            } catch (e) {}\n          }\n\n          var q = new URLSearchParams(window.location.search)\n          var rec = {\n            v: 1,\n            ts: Date.now(),\n            r: host,\n            lp: window.location.pathname.slice(0, 255),\n            s: (q.get(\"utm_source\") || \"\").slice(0, 80),\n            m: (q.get(\"utm_medium\") || \"\").slice(0, 80),\n            c: (q.get(\"utm_campaign\") || \"\").slice(0, 120),\n          }\n          // Click ids are the only signal left when an in-app browser strips the\n          // referrer. Record that one was PRESENT; never store its value, which\n          // is a per-user identifier.\n          if (!rec.r && !rec.s) {\n            if (q.get(\"fbclid\")) rec.s = \"fbclid\"\n            else if (q.get(\"gclid\")) rec.s = \"gclid\"\n            else if (q.get(\"msclkid\")) rec.s = \"msclkid\"\n          }\n\n          var json = JSON.stringify(rec)\n          // localStorage -> sessionStorage -> in-page. The last tier still wins\n          // the single-pageview case (land on /panel/register from a link and\n          // sign up without navigating). Storage blocked entirely yields no\n          // record at all, which reads as \"never captured\" -- deliberately NOT\n          // the same as \"direct\".\n          try {\n            window.localStorage.setItem(KEY, json)\n          } catch (e) {\n            try {\n              window.sessionStorage.setItem(KEY, json)\n            } catch (e2) {}\n          }\n          window.__sdlAttr = json\n        } catch (e) {}\n      })()\n    </script><!-- Auth bootstrap. Same contract as the theme script above: read\n         localStorage before paint, mark <html>, let CSS pick a branch. Auth is\n         localStorage-only (constraint #4), so the SSR HTML is byte-identical\n         for every visitor and the header always ships the logged-out control;\n         the signed-in avatar normally appears only once AuthSlot's chunk\n         hydrates. That makes ANY island-JS failure look exactly like a logout —\n         and a deploy deletes the previous build's chunks, so a stale document\n         can request one that no longer exists. Marking the document here lets\n         Header.astro show a static account link with zero island JS. AuthSlot\n         flips data-auth to \"live\"/\"out\" on mount and takes over. --><script>\n      (function () {\n        try {\n          var raw = localStorage.getItem(\"userData\")\n          if (!raw) return\n          var u = JSON.parse(raw)\n          if (!u || !u.token) return\n          var el = document.documentElement\n          el.setAttribute(\"data-auth\", \"in\")\n          // Mirror AuthSlot's no-avatar fallback (first letter of the name), so\n          // the static control and the hydrated one look the same. Restricted\n          // to a single letter/digit — it lands in a CSS `content` string.\n          var ch = String(u.username || u.name || \"S\").trim().charAt(0).toUpperCase()\n          if (/^[\\p{L}\\p{N}]$/u.test(ch)) el.style.setProperty(\"--auth-initial\", '\"' + ch + '\"')\n        } catch (e) {}\n      })()\n    </script><!-- Member pages (src/lib/memberPages.ts). Before paint, like the auth\n         bootstrap above: a signed-in member holding a live member pass is sent\n         from a public title/subtitle page to its /m/ twin, which also shows\n         soft-banned content. Signed out → any stored pass and its cookie are\n         dropped. Shapes are shared with src/lib/memberClient.ts, which mints\n         the pass; this script can't import it. --><script>\n      (function () {\n        try {\n          var K = \"subdlMemberPass\", HOP = \"subdlMemberHop\"\n          var CLEAR = \"subdl_mp=; Path=/m; Max-Age=0; Secure; SameSite=Lax\"\n          var p = location.pathname\n          var inMember = p.indexOf(\"/m/\") === 0\n          if (location.hash === \"#member-reset\") {\n            // The server refused the pass: forget it; memberClient mints anew.\n            localStorage.removeItem(K)\n            history.replaceState(history.state, \"\", p + location.search)\n          }\n          var u = JSON.parse(localStorage.getItem(\"userData\") || \"null\")\n          var mp = JSON.parse(localStorage.getItem(K) || \"null\")\n          if (!u || !u.token) {\n            if (mp) {\n              localStorage.removeItem(K)\n              document.cookie = CLEAR\n            }\n            return\n          }\n          if (inMember) {\n            sessionStorage.removeItem(HOP)\n            return\n          }\n          var now = Math.floor(Date.now() / 1000)\n          if (!mp || !mp.pass || mp.tag !== String(u.token).slice(-16) || !(mp.exp > now + 60)) return\n          // Same test as looksMirrored() in memberClient.ts; the gate re-checks.\n          if (/^\\/en(\\/|$)/.test(p) || !/^\\/(?:[a-z]{2,3}(?:-[A-Z]{2})?\\/)?(?:subtitle|s)\\/[^/]/.test(p)) return\n          // Loop guard: the gate sends us back here if the cookie didn't stick.\n          if (sessionStorage.getItem(HOP) === p) return\n          sessionStorage.setItem(HOP, p)\n          document.cookie = \"subdl_mp=\" + mp.pass + \"; Path=/m; Max-Age=\" + (mp.exp - now) + \"; Secure; SameSite=Lax\"\n          location.replace(\"/m\" + p + location.search + location.hash)\n        } catch (e) {}\n      })()\n    </script><meta name=\"keywords\" content=\"Frieren: Beyond Journey's End subtitles download, Frieren: Beyond Journey's End subtitles, Download Frieren: Beyond Journey's End subs, Frieren: Beyond Journey's End BluRay subtitles, Frieren: Beyond Journey's End HDTV subtitles, Free Frieren: Beyond Journey's End subtitle download, Frieren: Beyond Journey's End c