tton></li><li class=\"flex flex-col items-start justify-between gap-1 lg:flex-row lg:items-center\" data-ai-row data-episode-from=\"10\" data-episode-to=\"10\"><button type=\"button\" class=\"flex w-full flex-col items-start justify-between gap-1 text-left lg:flex-row lg:items-center\" data-ai-open data-source-nid=\"buUvGgLoXA4\" data-source-title=\"[Mugi] Sousou no Frieren S2 - 10 END\" data-source-language=\"arabic\" data-target=\"bn\" data-target-name=\"Bangla\" data-target-native=\"বাংলা\" data-episode=\"10\"><span dir=\"ltr\" class=\"inline-flex flex-wrap items-center gap-2 text-wrap break-all lg:w-full lg:overflow-hidden\"><span class=\"flex-shrink text-wrap break-all font-bold text-text2\">[Mugi] Sousou no Frieren S2 - 10 END</span><span class=\"inline-flex items-center rounded-md border border-border px-2 py-0.5 text-xs font-normal opacity-80\">E10</span></span><span class=\"inline-flex flex-shrink-0 flex-grow-0 items-center gap-2\"><span class=\"flex items-center rounded-sm bg-secondary p-1 text-sm\"><svg class=\"h-4 w-4 text-violet-600 dark:text-violet-400\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><use href=\"#ai-i-translate\"></use></svg><span class=\"ms-1 block text-text3 lg:hidden\">Translate now</span></span></span></button></li></ul></div></div></div></div></div><script>\n    // Row click → open the AI subtitle modal island (mounted by the page).\n    // Mirrors the /s/ page's subdl:opentranslate delegation pattern.\n    document.addEventListener(\"click\", function (e) {\n      var btn = e.target && e.target.closest && e.target.closest(\"[data-ai-open]\")\n      if (!btn) return\n      var container = btn.closest(\"[data-ai-subtitles]\")\n      window.dispatchEvent(\n        new CustomEvent(\"subdl:openaisubtitle\", {\n          detail: {\n            sourceNId: btn.getAttribute(\"data-source-nid\"),\n            sourceTitle: btn.getAttribute(\"data-source-title\"),\n            sourceLanguage: btn.getAttribute(\"data-source-language\"),\n            target: btn.getAttribute(\"data-target\"),\n            targetName: btn.getAttribute(\"data-target-name\"),\n            targetNative: btn.getAttribute(\"data-target-native\"),\n            episode: Number(btn.getAttribute(\"data-episode\")) || 0,\n            season: Number(container && container.getAttribute(\"data-season\")) || 0,\n          },\n        })\n      )\n    })\n  </script> </div> </div> <script>\n  // Delegated quality-group collapse (v3 grid-rows 0fr/1fr, no per-row JS).\n  document.addEventListener(\"click\", function (e) {\n    var header = e.target && e.target.closest && e.target.closest(\"[data-quality-header]\")\n    if (!header) return\n    var body = header.nextElementSibling\n    var chevron = header.querySelector(\"[data-chevron]\")\n    if (!body) return\n    var open = body.classList.contains(\"grid-rows-[1fr]\")\n    body.classList.toggle(\"grid-rows-[1fr]\", !open)\n    body.classList.toggle(\"grid-rows-[0fr]\", open)\n    if (chevron) chevron.style.transform = open ? \"rotate(180deg)\" : \"rotate(0deg)\"\n  })\n</script><div data-pc-slot=\"title\" data-pc-anchor=\"[data-subtitle-list] [data-list-view] [data-row]\" data-pc-api=\"https://api3.subdl.com\"> <template data-pc=\"title-strip\"> <div class=\"relative my-3 overflow-hidden rounded-md border border-[#f7e81f]/30 bg-gradient-to-r from-[#f7e81f]/10 via-secondary to-secondary\" data-astro-cid-jz42rphz><a href=\"/pro?utm_source=subdl&#38;utm_medium=house_card&#38;utm_campaign=pro_cards&#38;utm_content=title-strip&#38;utm_term=title\" class=\"flex flex-col gap-3 p-4 pe-10 sm:flex-row sm:items-center sm:gap-5 sm:p-5 sm:pe-10\" data-astro-cid-jz42rphz><div aria-hidden=\"true\" class=\"hidden h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-[#111827] text-[#f7e81f] sm:flex\" data-astro-cid-jz42rphz><svg viewBox=\"0 0 24 24\" class=\"h-8 w-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-l