 } catch (e) {}\n    var pick = forced && ids.indexOf(forced) >= 0 ? forced : null\n    var pending = false\n    if (!pick) {\n      if (navigator.webdriver || new RegExp(botPattern, \"i\").test(navigator.userAgent || \"\")) return\n      if (+(get(\"sdl_pc_hide_until\") || 0) > Date.now()) return\n      var paid = (get(\"sdl_pc_paid\") || \"\").charAt(0)\n      if (paid === \"1\") return\n      var token = null\n      try { token = JSON.parse(get(\"userData\") || \"null\").token } catch (e) {}\n      pending = !!token && paid !== \"0\"\n      // \"Last on top\" re-sorts list rows with CSS `order` after hydration; a\n      // card placed between rows now would not stay where it was put.\n      if (anchor && get(\"subtitleLatestFirst\") === \"true\") return\n      var key = \"sdl_pc_\" + name\n      pick = get(key)\n      if (ids.indexOf(pick) < 0) {\n        pick = ids[Math.floor(Math.random() * ids.length)]\n        try { if (ls) ls.setItem(key, pick) } catch (e) {}\n      }\n    }\n    // The first screen plus a margin: fonts and islands settling after parse\n    // can pull content up a little (measured: 16px on a title page).\n    var y = window.scrollY || 0\n    var fold = window.innerHeight + 80\n    var before = null\n    if (anchor) {\n      var rows = document.querySelectorAll(anchor)\n      for (var k = 0; k < rows.length && k < 100; k++) {\n        if (rows[k].getBoundingClientRect().top + y >= fold) { before = rows[k]; break }\n      }\n    }\n    if (!before && !forced && slot.getBoundingClientRect().top + y < fold) return\n    slot.setAttribute(\"data-pc-pick\", pick)\n    if (forced) slot.setAttribute(\"data-pc-forced\", \"\")\n    if (pending) return slot.setAttribute(\"data-pc-pending\", \"\")\n    var tpl = slot.querySelector('template[data-pc=\"' + pick + '\"]')\n    var card = document.createElement(before && before.tagName === \"LI\" ? \"li\" : \"div\")\n    card.setAttribute(\"data-pc\", pick)\n    card.setAttribute(\"data-pc-for\", name)\n    card.appendChild(tpl.content.cloneNode(true))\n    if (before) before.parentNode.insertBefore(card, before)\n    else slot.appendChild(card)\n    slot.setAttribute(\"data-pc-shown\", pick)\n  })()\n})();</script> </div></div></div> </div><footer class=\"site-footer pointer-events-none fixed bottom-[5px] left-[35px] right-[35px] z-[200] flex min-h-[20px] w-auto items-center justify-between\" data-astro-cid-sz7xmlte> <nav class=\"pointer-events-auto relative z-50 flex items-center justify-start\" style=\"margin-top:20px;\" data-astro-cid-sz7xmlte> <ul class=\"group flex flex-nowrap overflow-hidden whitespace-nowrap items-center text-stroke\" data-astro-cid-sz7xmlte> <li class=\"bg-transparent\" data-astro-cid-sz7xmlte> <button type=\"button\" data-langbox class=\"group inline-flex h-9 w-max items-center justify-center rounded-md px-4 py-2 text-sm font-semibold transition-colors hover:underline focus:outline-none disabled:pointer-events-none disabled:opacity-50 [text-shadow:_0_1px_5px_rgb(0_0_0_/_40%)] text-foreground\" data-astro-cid-sz7xmlte> Filter Languages </button> </li> <li class=\"bg-transparent\" data-astro-cid-sz7xmlte> <a href=\"/about\" class=\"group inline-flex h-9 w-max items-center justify-center rounded-md px-4 py-2 text-sm font-semibold transition-colors hover:underline focus:outline-none disabled:pointer-events-none disabled:opacity-50 [text-shadow:_0_1px_5px_rgb(0_0_0_/_40%)] text-foreground\" data-astro-cid-sz7xmlte> About </a> </li><li class=\"bg-transparent\" data-astro-cid-sz7xmlte> <a href=\"/ads\" class=\"group inline-flex h-9 w-max items-center justify-center rounded-md px-4 py-2 text-sm font-semibold transition-colors hover:underline focus:outline-none disabled:pointer-events-none disabled:opacity-50 [text-shadow:_0_1px_5px_rgb(0_0_0_/_40%)] text-foreground\" data-astro-cid-sz7xmlte> Advertise </a> </li><li class=\"bg-transparent\" data-astro-cid-sz7xmlte> <a href=\"/api-doc\" class=\"group inline-flex h-9 w-max items-center justify-center ro