cebookexternalhit|embedly|bingpreview|ia_archiver|phantomjs\";\n\n  (function () {\n    var slot = document.currentScript && document.currentScript.previousElementSibling\n    if (!slot || !slot.hasAttribute(\"data-pc-slot\")) return\n    var name = slot.getAttribute(\"data-pc-slot\")\n    var anchor = slot.getAttribute(\"data-pc-anchor\")\n    var tpls = slot.querySelectorAll(\"template[data-pc]\")\n    var ids = []\n    for (var i = 0; i < tpls.length; i++) ids.push(tpls[i].getAttribute(\"data-pc\"))\n    var ls = null\n    try { ls = window.localStorage } catch (e) {}\n    var get = function (k) { try { return ls ? ls.getItem(k) : null } catch (e) { return null } }\n    var forced = null\n    try { forced = new URLSearchParams(location.search).get(\"pc\") } catch (e) {}\n    var pick = forced && ids.indexOf(forced) >= 0 ? forced : null\n    var pending = false\n    if (!pick) {\n      if (navigator.webdriver || new RegExp(botPattern, \"i\").test(navigator.userAgent || \"\")) return\n      if (+(get(\"sdl_pc_hide_until\") || 0) > Date.now()) return\n      var paid = (get(\"sdl_pc_paid\") || \"\").charAt(0)\n      if (paid === \"1\") return\n      var token = null\n      try { token = JSON.parse(get(\"userData\") || \"null\").token } catch (e) {}\n      pending = !!token && paid !== \"0\"\n      // \"Last on top\" re-sorts list rows with CSS `order` after hydration; a\n      // card placed between rows now would not stay where it was put.\n      if (anchor && get(\"subtitleLatestFirst\") === \"true\") return\n      var key = \"sdl_pc_\" + name\n      pick = get(key)\n      if (ids.indexOf(pick) < 0) {\n        pick = ids[Math.floor(Math.random() * ids.length)]\n        try { if (ls) ls.setItem(key, pick) } catch (e) {}\n      }\n    }\n    // The first screen plus a margin: fonts and islands settling after parse\n    // can pull content up a little (measured: 16px on a title page).\n    var y = window.scrollY || 0\n    var fold = window.innerHeight + 80\n    var before = null\n    if (anchor) {\n      var rows = document.querySelectorAll(anchor)\n      for (var k = 0; k < rows.length && k < 100; k++) {\n        if (rows[k].getBoundingClientRect().top + y >= fold) { before = rows[k]; break }\n      }\n    }\n    if (!before && !forced && slot.getBoundingClientRect().top + y < fold) return\n    slot.setAttribute(\"data-pc-pick\", pick)\n    if (forced) slot.setAttribute(\"data-pc-forced\", \"\")\n    if (pending) return slot.setAttribute(\"data-pc-pending\", \"\")\n    var tpl = slot.querySelector('template[data-pc=\"' + pick + '\"]')\n    var card = document.createElement(before && before.tagName === \"LI\" ? \"li\" : \"div\")\n    card.setAttribute(\"data-pc\", pick)\n    card.setAttribute(\"data-pc-for\", name)\n    card.appendChild(tpl.content.cloneNode(true))\n    if (before) before.parentNode.insertBefore(card, before)\n    else slot.appendChild(card)\n    slot.setAttribute(\"data-pc-shown\", pick)\n  })()\n})();</script> <astro-island uid=\"Zrv7xC\" prefix=\"r8\" component-url=\"/_astro/c-Bgx1x59j.js\" component-export=\"default\" renderer-url=\"/_astro/c-D8efolcu.js\" props=\"{&quot;ui&quot;:[0,{&quot;locale&quot;:[0,&quot;en&quot;],&quot;messages&quot;:[0,{&quot;subtitle_show_more_count&quot;:[0,&quot;Show {count} more {language} subtitles&quot;],&quot;table_author&quot;:[0,&quot;Author&quot;],&quot;table_download&quot;:[0,&quot;Download&quot;],&quot;table_language&quot;:[0,&quot;Language&quot;],&quot;table_quality&quot;:[0,&quot;Quality&quot;],&quot;table_release&quot;:[0,&quot;Release&quot;],&quot;ui_author_following&quot;:[0,&quot;Following&quot;],&quot;ui_static_1f89134f&quot;:[0,&quot;Active&quot;],&quot;ui_static_3352afdc&quot;:[0,&quot;Pending&quot;],&quot;ui_static_5fc652c3&quot;:[0,&quot;Translated&quot;],&quot;ui_static_63336b73&quot;:[0,&quot;Trial&quot;],&quot;ui_static_6964bb19&quot;:[0,&quot;Download&quot;],&quot;ui_static_bca9f3d2&quot;:[0,&quot;Expired&quot;],&quot;ui_static_f050c067&quot;:[0,&quot;Reje