ceLanguage: btn.getAttribute(\"data-source-language\"),\n            target: btn.getAttribute(\"data-target\"),\n            targetName: btn.getAttribute(\"data-target-name\"),\n            targetNative: btn.getAttribute(\"data-target-native\"),\n            episode: Number(btn.getAttribute(\"data-episode\")) || 0,\n            season: Number(container && container.getAttribute(\"data-season\")) || 0,\n          },\n        })\n      )\n    })\n  </script> </div> </div> <script>\n  // Delegated quality-group collapse (v3 grid-rows 0fr/1fr, no per-row JS).\n  document.addEventListener(\"click\", function (e) {\n    var header = e.target && e.target.closest && e.target.closest(\"[data-quality-header]\")\n    if (!header) return\n    var body = header.nextElementSibling\n    var chevron = header.querySelector(\"[data-chevron]\")\n    if (!body) return\n    var open = body.classList.contains(\"grid-rows-[1fr]\")\n    body.classList.toggle(\"grid-rows-[1fr]\", !open)\n    body.classList.toggle(\"grid-rows-[0fr]\", open)\n    if (chevron) chevron.style.transform = open ? \"rotate(180deg)\" : \"rotate(0deg)\"\n  })\n</script><div data-pc-slot=\"title\" data-pc-anchor=\"[data-subtitle-list] [data-list-view] [data-row]\" data-pc-api=\"https://api3.subdl.com\"> <template data-pc=\"title-strip\"> <div class=\"relative my-3 overflow-hidden rounded-md border border-[#f7e81f]/30 bg-gradient-to-r from-[#f7e81f]/10 via-secondary to-secondary\" data-astro-cid-jz42rphz><a href=\"/pro?utm_source=subdl&#38;utm_medium=house_card&#38;utm_campaign=pro_cards&#38;utm_content=title-strip&#38;utm_term=title\" class=\"flex flex-col gap-3 p-4 pe-10 sm:flex-row sm:items-center sm:gap-5 sm:p-5 sm:pe-10\" data-astro-cid-jz42rphz><div aria-hidden=\"true\" class=\"hidden h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-[#111827] text-[#f7e81f] sm:flex\" data-astro-cid-jz42rphz><svg viewBox=\"0 0 24 24\" class=\"h-8 w-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-l