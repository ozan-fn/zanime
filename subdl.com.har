,&quot;viewJob&quot;:[0,&quot;Continue translation&quot;],&quot;viewResult&quot;:[0,&quot;View subtitle&quot;],&quot;start&quot;:[0,&quot;Start translation&quot;],&quot;sourceChanged&quot;:[0,&quot;The source or selected files are no longer available. Choose another release or review the available files.&quot;],&quot;targetChanged&quot;:[0,&quot;This target language is no longer supported. Choose another language.&quot;],&quot;existing&quot;:[0,&quot;This subtitle is already being translated.&quot;],&quot;replace&quot;:[0,&quot;Release / pack&quot;]}],&quot;trialLabels&quot;:[0,{&quot;title&quot;:[0,&quot;Translate this subtitle free&quot;],&quot;points&quot;:[1,[[0,&quot;3 AI translations with a free account&quot;],[0,&quot;No card needed&quot;],[0,&quot;Use them within 7 days&quot;]]],&quot;signup&quot;:[0,&quot;Sign up free&quot;],&quot;note&quot;:[0,&quot;Free trial: {remaining} of 3 AI translations left. No card needed.&quot;],&quot;ends&quot;:[0,&quot;Use them by {date}.&quot;],&quot;endedTitle&quot;:[0,&quot;Your free trial has ended&quot;],&quot;endedBody&quot;:[0,&quot;Keep translating with SubDL Plus: 60 AI translations a month for $3.&quot;],&quot;upgrade&quot;:[0,&quot;Get Plus&quot;],&quot;oneFile&quot;:[0,&quot;Free translations work one file at a time. Select a single file.&quot;],&quot;cta&quot;:[0,&quot;Translate free with AI&quot;],&quot;seasonTitle&quot;:[0,&quot;Translate the rest of Season {season}&quot;],&quot;seasonBody&quot;:[0,&quot;Season {season} has {left} more episodes. SubDL Plus translates the whole season at once: 60 AI translations a month for $3.&quot;],&quot;seasonBodyNoCount&quot;:[0,&quot;SubDL Plus translates the whole season at once: 60 AI translations a month for $3.&quot;],&quot;seasonFreeLeft&quot;:[0,&quot;You still have {remaining} free translations for the next episodes.&quot;]}],&quot;loginPath&quot;:[0,&quot;/panel/login&quot;],&quot;registerPath&quot;:[0,&quot;/panel/register&quot;],&quot;plansPath&quot;:[0,&quot;/pro&quot;],&quot;plusCheckoutPath&quot;:[0,&quot;/pro/checkout?tier=plus&amp;interval=monthly&quot;],&quot;data-astro-cid-qo5xhe7c&quot;:[0,true]}\" ssr client=\"only\" opts=\"{&quot;name&quot;:&quot;TranslateModal&quot;,&quot;value&quot;:&quot;react&quot;}\"></astro-island>  <!-- web-vitals → GA4 \"web_vitals\" events, segmented by route section.\n         Tiny module, not an island. Mirrors v3 reportWebVitals schema.\n         SubDL's own support-chat bootstrap rides in the same <script> so the\n         two share one deferred module request instead of two (it self-defers\n         the widget loader to idle-after-load — see lib/supportChat.ts). --> <script type=\"module\" src=\"/_astro/c-DVbJuLty.js\"></script> <!-- Visitor stats: one /statsLog per page load + a /visitors/heartbeat\n         presence ping every 60s while the tab is visible. Ports v3's\n         useStats (statsLog on route, heartbeat on visibility) — but v4 is an\n         MPA so every navigation is a real page load and the on-load fire\n         replaces v3's router listener. Feeds the internal traffic/visitor\n         dashboards, which have had no v4 data since cutover. Best-effort:\n         wrapped in try/catch and .catch so it never blocks a public page.\n\n         v3 skipped this on its admin segment. That exemption is GONE here, and\n         removing it is a security fix, not a cleanup: v4 serves no such route,\n         so the only page the guard could ever suppress was its 404 — meaning\n         the 404 for that one path fired no /statsLog while every other 404\n         did. Identical bytes, different observable behaviour: still a\n         discovery oracle (CLAUDE.md rule 4). The admin console is not affected\n         either way — it renders from ConsolePage.astro, which includes none of\n         this file. --> <script>(function(){const READ_API = \"https://api2.subdl.com\";\n\n      (function () {\n        try {\n          var urlPath = location.pathname + location.search\n\n          try {\n            var s = new URL(\"/statsLog\", READ_API)\n            s.searchParams.set(\n              \"timeZone\",\n              (Intl.DateTimeFormat().resolvedOptions().timeZone || \"\")\n            )\n            s.searchParams.set(\"url\", urlPath)\n            // Where this visitor came FROM. The api cannot read it off the\n            // Referer header — that header holds the SubDL page making this\n            // fetch — so it travels explicitly. api3 classifies it into\n            // search / AI / neither and DISCARDS the string; it is never\n            // stored, logged or forwarded. Only the origin is sent (the\n            // default referrer policy already trims search URLs to that), and\n            // an internal referrer is dropped here so we never ship a reader's\n            // own browsing path back to ourselves.\n            try {\n              var ref = document.referrer || \"\"\n              if (ref && new URL(ref).origin !== location.origin) {\n                s.searchParams.set(\"ref\", new URL(ref).origin)\n              }\n            } catch (e) {}\n            s.searchParams.set(\"t\", Date.now().toString())\n            fetch(s.toString(), { cache: \"no-store\", keepalive: true }).catch(function () {})\n          } catch (e) {}\n\n          var sendHeartbeat = function () {\n            if (document.visibilityState !== \"visible\") return\n            try {\n              var h = new URL(\"/visitors/heartbeat\", READ_API)\n              h.searchParams.set(\"url\", location.pathname + location.search)\n              h.searchParams.set(\"t\", Date.now().toString())\n              fetch(h.toString(), { cache: \"no-store\", keepalive: true }).catch(function () {})\n            } catch (e) {}\n          }\n\n          var interval\n          var stop = function () {\n            if (interval !== undefined) {\n              clearInterval(interval)\n              interval = undefined\n            }\n          }\n          var start = function () {\n            stop()\n            if (document.visibilityState === \"visible\") {\n              interval = setInterval(sendHeartbeat, 60000)\n            }\n          }\n          document.addEventListener(\"visibilitychange\", function () {\n            if (document.visibilityState === \"visible\") {\n              sendHeartbeat()\n              start()\n            } else {\n              stop()\n            }\n          })\n          start()\n        } catch (e) {}\n      })()\n    })();</script> <!-- Remove both retired root-scoped workers. /glx_16809.js was the old\n         advertising/push worker; keep this cleanup after deleting that file so\n         returning users lose the already-installed registration too.\n\n         NOTE: this filter is an ALLOWLIST of paths to remove and must never\n         become \"unregister everything\" — /push-sw.js is our own push worker.\n         See CLAUDE.md §6. --> <script>\n      (function () {\n        if (typeof navigator === \"undefined\" || !(\"serviceWorker\" in navigator)) return\n        navigator.serviceWorker\n          .getRegistrations()\n          .then(function (regs) {\n            return Promise.all(\n              regs\n                .filter(function (r) {\n                  var w = r.active || r.waiting || r.installing\n                  if (!w) return false\n                  var workerPath = new URL(w.scriptURL).pathname\n                  return workerPath === \"/sw.js\" || workerPath === \"/glx_16809.js\"\n                })\n                .map(function (r) {\n                  return r.unregister()\n                })\n            )\n          })\n          .catch(function () {})\n      })()\n    </script> <!-- Silently re-subscribe browsers that ALREADY granted notification\n         permission — the Galaksion recovery path.\n\n         Their old subscriptions died with glx_16809.js and cannot be\n         transferred (bound to Galaksion's VAPID key), but the PERMISSION is per\n         ORIGIN and survives, so pushManager.subscribe() with our key raises NO\n         prompt. This gate is what makes that reachable from ordinary pages\n         rather than only /panel.\n\n         The gate is deliberately this small and this cheap:\n           - it never prompts (only acts when permission is already \"granted\");\n           - ~86% of this site's traffic is bots, which have no Notification\n             API and stop at the first condition, fetching nothing;\n           - the real work lives in /push-harvest.js, a plain static file, so\n             none of it enters the Astro bundle or the public JS budget. --> <script>(function(){const pushApi = \"https://api3.subdl.com\";\nconst pushKey = \"BIEAQ_eF9wqlQs4UzDiayPygtvyH4RShSf5Hg5WlqEPIFS0lTeHn0oksdpyM-8Zm_2uyH6DcZnKnqpDbtoWJTuM\";\n\n      (function () {\n        if (!pushKey) return\n        if (typeof navigator === \"undefined\" || !(\"serviceWorker\" in navigator)) return\n        if (!(\"PushManager\" in window) || !(\"Notification\" in window)) return\n        if (Notification.permission !== \"granted\") return\n\n        var s = document.createElement(\"script\")\n        s.src = \"/push-harvest.js\"\n        s.async = true\n        s.dataset.api = pushApi\n        s.dataset.key = pushKey\n        document.head.appendChild(s)\n      })()\n    })();</script> <script type=\"module\" src=\"https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092\" integrity=\"sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==\" data-cf-beacon='{\"version\":\"2024.11.0\",\"token\":\"28f9999552004ab6a8738fe301b51d62\",\"spa\":2}' crossorigin=\"anonymous\"></script>\n</body> </html> "
