# Salin ke .env. Nilai kosong = fitur terkait mati, API tetap jalan.

# Terjemahan subtitle Indonesia (Gemini, model gemini-3.1-flash-lite).
# Kosong → POST /api/subid/batch balas 400. Key dari https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cache Redis (opsional), mis. rediss://default:<pass>@<host>:6379. Kosong = tanpa cache.
REDIS_URL=

# Level logger env_logger (opsional). Default: info
RUST_LOG=info
