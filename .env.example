# Salin ke .env, lalu sesuaikan.
PORT=8080
# Batas pekerja paralel (resolve server & terjemahan cue).
WORKERS=20
# Proxy untuk subdl + embedmaster; kosongkan untuk koneksi langsung.
# Contoh HTTP:   http://user:pass@p.webshare.io:80
# Contoh SOCKS5: socks5://user:pass@p.webshare.io:80
# Webshare: sufiks username (-1, -2, ...) memilih IP keluar. Bila target
# memblokir (403/429 atau Turnstile), -1 s/d -10 diuji paralel dan yang lolos
# ditulis kembali ke baris PROXY_URL di .env (tanpa restart).
PROXY_URL=
