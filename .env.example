# Salin ke .env. Nilai kosong = fitur terkait mati, API tetap jalan.

# Terjemahan subtitle Indonesia (Gemini, model gemini-3.1-flash-lite).
# Bisa banyak key (pisah koma) → dipakai round-robin. Kosong → POST /api/subid/batch balas 400.
# Key dari https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini (opsional). Default: gemini-3.5-flash-lite (free tier, murah).
# Ganti tanpa rebuild, mis. gemini-3.1-flash-lite bila model default penuh (503).
GEMINI_MODEL=

# Cache Redis (opsional), mis. rediss://default:<pass>@<host>:6379. Kosong = tanpa cache.
REDIS_URL=

# Port server (opsional). Default: 3000
PORT=3000
