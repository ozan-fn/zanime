# Salin ke .env, lalu isi kredensial Tigris dan nama bucket private.
PORT=8080
MAX_MEMORY_MB=200
AWS_ACCESS_KEY_ID=tid_your_access_key
AWS_SECRET_ACCESS_KEY=tsec_your_secret_key
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_ENDPOINT_URL_IAM=https://iam.storage.dev
AWS_REGION=auto
S3_BUCKET=your-private-bucket
# Folder di dalam bucket + batas total, video terlama dihapus saat penuh.
S3_PREFIX=zanime
S3_LIMIT_MB=4096
# 1 = player baca langsung dari Tigris (butuh CORS GET/HEAD), 0 = lewat proxy server.
S3_DIRECT=1
# Magnet untuk konten yang kamu punya izin untuk upload.
S3_TEST_MAGNET=
