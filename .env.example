[TEMPLATE]
# Salin ke .env. Nilai kosong = fitur terkait mati, API tetap jalan.

# Terjemahan subtitle Indonesia (endpoint kompatibel OpenAI + Bearer key).
# Bisa banyak key (pisah koma) → dipakai round-robin. Kosong → POST /api/subid/batch balas 400.
OPENAI_API_KEY=

# Base URL kompatibel OpenAI (opsional). Default: https://kenari.id/v1
# Mistral: https://api.mistral.ai/v1
OPENAI_BASE_URL=https://api.mistral.ai/v1

# Model (opsional). Default: gemma-4-31b-it
# Mistral free mode hanya membuka jajaran Ministral: 3b (750 rpm), 8b (188 rpm),
# 14b (30 rpm). mistral-small/medium = 0 rpm → 429 permanen, large = 403.
OPENAI_MODEL=ministral-8b-latest

# Cache Redis (opsional), mis. rediss://default:<pass>@<host>:6379. Kosong = tanpa cache.
REDIS_URL=

# Level logger env_logger (opsional). Default: info
RUST_LOG=info

# Port server (opsional). Default: 3000
PORT=3000
