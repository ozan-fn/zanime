# Salin ke .env, lalu sesuaikan.
PORT=8080
# Folder cache piece torrent (relatif ke working directory), default
# ./tmp/cache — set CACHE_DIR env hanya untuk menggantinya. Isinya boleh
# dihapus kapan saja: torrent diambil ulang dari magnet saat dibutuhkan.
# Batas ukuran cache di disk (MiB). Kalau lewat, torrent paling lama (LRU)
# dihapus utuh; torrent yang sedang diputar tidak pernah dihapus.
MAX_CACHE_MB=4096
